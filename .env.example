# Optional locally (a temporary secret is generated if missing). REQUIRED on Vercel.
# Format: NAME=value  (no quotes, no spaces around "=")
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Postgres connection string (Neon / Supabase / Vercel Postgres).
# Leave empty locally to use a non-persistent in-memory store. REQUIRED on Vercel.
DATABASE_URL=
